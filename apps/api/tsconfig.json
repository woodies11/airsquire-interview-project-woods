{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "exclude": ["node_modules", "uploads", "dist"]
}
